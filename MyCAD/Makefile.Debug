####### Compiler, tools and options

CC            = gcc
CXX           = g++
DEFINES       = -DUNICODE -D_UNICODE -DWIN32 -DMINGW_HAS_SECURE_API=1 -DQT_DISABLE_DEPRECATED_UP_TO=0x060000 -DQT_WIDGETS_LIB -DQT_GUI_LIB -DQT_CORE_LIB -DQT_NEEDS_QMAIN
CFLAGS        = -fno-keep-inline-dllexport -g -Wall -Wextra -Wextra $(DEFINES)
CXXFLAGS      = -fno-keep-inline-dllexport -g -std=gnu++1z -Wall -Wextra -Wextra -fexceptions -mthreads $(DEFINES)
INCPATH       = -I. -I. -IC:/Qt/mingw_64/include -IC:/Qt/mingw_64/include/QtWidgets -IC:/Qt/mingw_64/include/QtGui -IC:/Qt/mingw_64/include/QtCore -Idebug -I/include -I/mnt/c/Qt/mingw_64/include -IC:/Qt/mingw_64/mkspecs/win32-g++ 
